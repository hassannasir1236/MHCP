DirectoryIndex index.html index.php

# Redirect old .php page URLs to .html (keep sendlead.php working)
RewriteEngine On

RewriteRule ^index\.php$ index.html [R=301,L]
RewriteRule ^about\.php$ about.html [R=301,L]
RewriteRule ^contact\.php$ contact.html [R=301,L]
RewriteRule ^communities\.php$ communities.html [R=301,L]
RewriteRule ^thank-you\.php$ thank-you.html [R=301,L]
RewriteRule ^communities/sweet-lake\.php$ communities/sweet-lake.html [R=301,L]
RewriteRule ^communities/sturgis-commons\.php$ communities/sturgis-commons.html [R=301,L]
RewriteRule ^communities/pine-crest\.php$ communities/pine-crest.html [R=301,L]

DirectoryIndex index.php index.html

# Keep old .html URLs working by redirecting to .php
RewriteEngine On

RewriteRule ^index\.html$ index.php [R=301,L]
RewriteRule ^about\.html$ about.php [R=301,L]
RewriteRule ^contact\.html$ contact.php [R=301,L]
RewriteRule ^communities\.html$ communities.php [R=301,L]
RewriteRule ^thank-you\.html$ thank-you.php [R=301,L]
RewriteRule ^communities/sweet-lake\.html$ communities/sweet-lake.php [R=301,L]
RewriteRule ^communities/sturgis-commons\.html$ communities/sturgis-commons.php [R=301,L]
RewriteRule ^communities/pine-crest\.html$ communities/pine-crest.php [R=301,L]
